[Unit]
Description=Frameshift still-artwork host
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=frameshift
Group=frameshift
SupplementaryGroups=frameshift-control frameshift-observer
ExecStartPre=+/usr/lib/frameshift/provision-runtime
ExecStart=/usr/lib/frameshift/launch-service
ExecStartPost=/usr/lib/frameshift/check-ready
WorkingDirectory=/
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=40
KillMode=mixed
OOMPolicy=stop
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=-/var/lib/frameshift -/run/frameshift
MemoryHigh=768M
MemoryMax=1G
TasksMax=512
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=frameshift
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
