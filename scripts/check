#!/bin/sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

check_policy() {
  prohibited_files=$(
    git -C "$repository_root" ls-files --cached --others --exclude-standard -- \
      '*.py' '*.pyi' 'requirements*.txt' 'pyproject.toml'
  )

  if [ -n "$prohibited_files" ]; then
    echo "Repository-owned Python files are prohibited:" >&2
    echo "$prohibited_files" >&2
    return 1
  fi

  mise exec -- shellcheck \
    "$repository_root/.githooks/commit-msg" \
    "$repository_root/scripts/build-macos-icons" \
    "$repository_root/scripts/build-guide" \
    "$repository_root/scripts/build-site" \
    "$repository_root/scripts/assemble-site" \
    "$repository_root/scripts/derive-macos-channels" \
    "$repository_root/scripts/sign-macos-channels" \
    "$repository_root/scripts/verify-macos-channels" \
    "$repository_root/scripts/build-release-guide" \
    "$repository_root/scripts/check" \
    "$repository_root/scripts/check-workspace" \
    "$repository_root/scripts/check-elixir-docs" \
    "$repository_root/scripts/check-core-release" \
    "$repository_root/scripts/check-build-spec" \
    "$repository_root/scripts/check-kernel-parity" \
    "$repository_root/scripts/check-keychain-pairing" \
    "$repository_root/scripts/check-packaged-app" \
    "$repository_root/scripts/check-macos-closure" \
    "$repository_root/scripts/check-platform-observability" \
    "$repository_root/scripts/check-linux-codec-owner" \
    "$repository_root/scripts/check-linux-release" \
    "$repository_root/scripts/check-linux-deb" \
    "$repository_root/release/linux/check-systemd" \
    "$repository_root/release/linux/codec-stop-check" \
    "$repository_root/scripts/check-linux-candidate" \
    "$repository_root/codec/vendor/jpeg-decoder/check-source" \
    "$repository_root/scripts/format" \
    "$repository_root/scripts/frameshift-maintenance" \
    "$repository_root/scripts/index" \
    "$repository_root/scripts/launch-bundled-core" \
    "$repository_root/scripts/package-macos" \
    "$repository_root/scripts/prepare-macos-sdk" \
    "$repository_root/scripts/package-macos-dmg" \
    "$repository_root/scripts/package-macos-universal" \
    "$repository_root/scripts/package-macos-candidate" \
    "$repository_root/scripts/package-macos-cohort" \
    "$repository_root/scripts/stage-macos-candidate" \
    "$repository_root/scripts/stage-macos-material" \
    "$repository_root/scripts/package-linux" \
    "$repository_root/scripts/package-linux-deb" \
    "$repository_root/scripts/package-linux-candidate" \
    "$repository_root/scripts/stage-linux-candidate" \
    "$repository_root/scripts/inspect-release-channel" \
    "$repository_root/scripts/check-core-material" \
    "$repository_root/scripts/check-core-generated" \
    "$repository_root/scripts/collect-dependency-notices" \
    "$repository_root/scripts/check-cargo-material" \
    "$repository_root/scripts/check-sdk-resources" \
    "$repository_root/scripts/check-sparkle-source" \
    "$repository_root/scripts/collect-codec-notices" \
    "$repository_root/scripts/check-gleam-material" \
    "$repository_root/scripts/prepare-gleam-metadata" \
    "$repository_root/scripts/check-macos-material" \
    "$repository_root/scripts/record-release-inputs" \
    "$repository_root/scripts/verify-release-inputs" \
    "$repository_root/release/linux/policy.sh" \
    "$repository_root/release/linux/provision-runtime" \
    "$repository_root/release/linux/launch-service" \
    "$repository_root/release/linux/check-ready" \
    "$repository_root/release/linux/frameshiftctl" \
    "$repository_root/release/linux/frameshift-identity" \
    "$repository_root/release/linux/frameshift-maintenance" \
    "$repository_root/release/linux/maintenance-entrypoint" \
    "$repository_root/release/linux/build-tree" \
    "$repository_root/release/linux/prepare-context" \
    "$repository_root/release/linux/check-closure" \
    "$repository_root/release/linux/check-deb" \
    "$repository_root/release/linux/check-candidate" \
    "$repository_root/release/linux/fixture-systemctl" \
    "$repository_root/release/linux/make-deb" \
    "$repository_root/release/linux/debian/preinst" \
    "$repository_root/release/linux/debian/postinst" \
    "$repository_root/release/linux/debian/prerm" \
    "$repository_root/release/linux/debian/postrm" \
    "$repository_root/apps/core/test/fixtures/hanging-worker.sh" \
    "$repository_root/apps/core/rel/overlays/bin/frameshiftctl" \
    "$repository_root/apps/core/rel/overlays/bin/frameshift-identity"
  mise exec -- actionlint "$repository_root"/.github/workflows/*.yml
  "$repository_root/scripts/check-elixir-docs"
  "$repository_root/scripts/check-workspace"
  mise exec -- node --test "$repository_root/scripts/conjunct/artifacts.test.mjs"
}

check_renderer() {
  (
    cd "$repository_root/renderer"
    mise exec -- zig fmt --check build.zig src
    mise exec -- zig build test
    mise exec -- zig build test -Doptimize=ReleaseSafe
    mise exec -- zig build -Doptimize=ReleaseSafe
  )
}

check_codec() {
  (
    cd "$repository_root/codec"
    ./vendor/jpeg-decoder/check-source
    mise exec -- cargo fmt --check
    mise exec -- cargo clippy --locked --all-targets -- -D warnings
    mise exec -- cargo test --locked
    mise exec -- cargo test --locked --release
    mise exec -- cargo build --locked --release
  )
}

check_linux_codec() {
  (
    cd "$repository_root/apps/core"
    mise exec -- env MIX_ENV=test mix compile --warnings-as-errors
  )
  docker build --platform linux/arm64 --file "$repository_root/codec/test.Dockerfile" \
    --tag frameshift-codec-arm64:fixture "$repository_root/codec"
  docker run --rm --platform linux/arm64 --network none --read-only \
    frameshift-codec-arm64:fixture
  "$repository_root/scripts/check-linux-codec-owner" arm64
  docker build --platform linux/amd64 --file "$repository_root/codec/test.Dockerfile" \
    --tag frameshift-codec-amd64:fixture "$repository_root/codec"
  docker run --rm --platform linux/amd64 --network none --read-only \
    frameshift-codec-amd64:fixture
  "$repository_root/scripts/check-linux-codec-owner" amd64
}

check_linux_release() {
  mise exec -- node --check "$repository_root/release/linux/record-inputs.mjs"
  (
    cd "$repository_root/apps/core"
    mise exec -- mix format --check-formatted ../../release/linux/*.exs
  )
  "$repository_root/scripts/check-linux-release" arm64
  "$repository_root/scripts/check-linux-release" amd64
}

check_linux_deb() {
  mise exec -- node --check "$repository_root/release/linux/record-package.mjs"
  (
    cd "$repository_root/apps/core"
    mise exec -- mix format --check-formatted ../../release/linux/*.exs
  )
  "$repository_root/scripts/check-linux-deb" arm64
  "$repository_root/scripts/check-linux-deb" amd64
}

check_platform() {
  (
    cd "$repository_root/apps/build-platform/assets"
    mise exec -- npm run check
    mise exec -- npm run lint
    mise exec -- npm run build
  )

  (
    cd "$repository_root/apps/build-platform"
    mise exec -- mix hex.audit
    mise exec -- mix check
    mise exec -- mix phoenix_assets.gen --check
    mise exec -- mix phoenix_assets.doctor --production
    mise exec -- mix ash_postgres.generate_migrations --check
  )
}

check_platform_browser() {
  (
    cd "$repository_root/apps/build-platform"
    mise exec -- node --check ops/session-browser.mjs
    mise exec -- node ops/session-browser.mjs
  )
}

check_kernel() {
  (
    cd "$repository_root/packages/decision-kernel"
    mise exec -- gleam format --check src test
    mise exec -- gleam build --target erlang --warnings-as-errors
    mise exec -- gleam build --target javascript --warnings-as-errors
    mise exec -- gleam test --target erlang
    mise exec -- gleam test --target javascript
  )
  "$repository_root/scripts/check-kernel-parity"
}

check_guide() {
  "$repository_root/scripts/build-guide"
  mise exec -- node --check "$repository_root/apps/guide/build.mjs"
  mise exec -- node --check "$repository_root/apps/guide/src/app.mjs"
  mise exec -- node --check "$repository_root/apps/guide/src/lab.mjs"
  mise exec -- node --check "$repository_root/apps/guide/release-markup.mjs"
  mise exec -- node --check "$repository_root/apps/guide/test/browser-smoke.mjs"
  mise exec -- node --test \
    "$repository_root/apps/guide/test/lab.test.mjs" \
    "$repository_root/apps/guide/test/release-markup.test.mjs"
  mise exec -- node "$repository_root/apps/guide/test/release-build.mjs"
}

check_release() {
  mise exec -- node --check "$repository_root/release/manifest.mjs"
  mise exec -- node --check "$repository_root/release/files.mjs"
  mise exec -- node --check "$repository_root/release/channel.mjs"
  mise exec -- node --check "$repository_root/release/channel-cli.mjs"
  mise exec -- node --check "$repository_root/release/verify.mjs"
  mise exec -- node --check "$repository_root/release/signer.mjs"
  mise exec -- node --check "$repository_root/release/sign.mjs"
  mise exec -- node --check "$repository_root/release/source.mjs"
  mise exec -- node --check "$repository_root/release/inputs.mjs"
  mise exec -- node --check "$repository_root/release/core-material.mjs"
  mise exec -- node --check "$repository_root/release/core-material-cli.mjs"
  mise exec -- node --check "$repository_root/release/core-generated.mjs"
  mise exec -- node --check "$repository_root/release/core-generated-cli.mjs"
  mise exec -- node --check "$repository_root/release/core-generated-fixture.mjs"
  mise exec -- node --check "$repository_root/release/notices.mjs"
  mise exec -- node --check "$repository_root/release/notices-cli.mjs"
  mise exec -- node --check "$repository_root/release/notices-fixture.mjs"
  mise exec -- node --check "$repository_root/release/cargo-material.mjs"
  mise exec -- node --check "$repository_root/release/cargo-material-child.mjs"
  mise exec -- node --check "$repository_root/release/cargo-material-cli.mjs"
  mise exec -- node --check "$repository_root/release/cargo-material-fixture.mjs"
  mise exec -- node --check "$repository_root/release/codec-notices.mjs"
  mise exec -- node --check "$repository_root/release/codec-notices-cli.mjs"
  mise exec -- node --check "$repository_root/release/macos/sdk-resources.mjs"
  mise exec -- node --check "$repository_root/release/macos/sdk-resources-cli.mjs"
  mise exec -- node --check "$repository_root/release/gleam-material.mjs"
  mise exec -- node --check "$repository_root/release/gleam-material-cli.mjs"
  mise exec -- node --check "$repository_root/release/gleam-metadata.mjs"
  mise exec -- node --check "$repository_root/release/gleam-metadata-cli.mjs"
  mise exec -- node --check "$repository_root/release/input-cli.mjs"
  mise exec -- node --check "$repository_root/release/remote.mjs"
  mise exec -- node --check "$repository_root/release/workflow.mjs"
  mise exec -- node --check "$repository_root/release/workflow-cli.mjs"
  mise exec -- node --check "$repository_root/release/ustar.mjs"
  mise exec -- node --check "$repository_root/release/macos-framework.mjs"
  mise exec -- node --check "$repository_root/release/material-receipts.mjs"
  mise exec -- node --check "$repository_root/release/material-handoff.mjs"
  for source in "$repository_root"/release/linux/*.mjs; do mise exec -- node --check "$source"; done
  for source in "$repository_root"/release/macos/*.mjs; do mise exec -- node --check "$source"; done
  (
    cd "$repository_root/apps/core"
    mise exec -- mix format --check-formatted ../../release/read-version.exs ../../release/core-material.exs ../../release/core-generated.exs ../../release/linux/verify-version.exs
  )
  mise exec -- node --test \
    "$repository_root/release/manifest.test.mjs" \
    "$repository_root/release/signer.test.mjs" \
    "$repository_root/release/files.test.mjs" \
    "$repository_root/release/channel.test.mjs" \
    "$repository_root/release/inputs.test.mjs" \
    "$repository_root/release/core-material.test.mjs" \
    "$repository_root/release/core-generated.test.mjs" \
    "$repository_root/release/notices.test.mjs" \
    "$repository_root/release/cargo-material.test.mjs" \
    "$repository_root/release/codec-notices.test.mjs" \
    "$repository_root/release/gleam-material.test.mjs" \
    "$repository_root/release/gleam-metadata.test.mjs" \
    "$repository_root/release/linux/candidate.test.mjs" \
    "$repository_root/release/linux/working-directory.test.mjs" \
    "$repository_root/release/linux/source-material.test.mjs" \
    "$repository_root/release/linux/material-handoff.test.mjs" \
    "$repository_root/release/linux/ustar.test.mjs" \
    "$repository_root/release/workflow.test.mjs"
  mise exec -- node --test "$repository_root"/release/macos/*.test.mjs
}

check_guide_browser() {
  check_guide
  mise exec -- node "$repository_root/apps/guide/test/browser-smoke.mjs"
}

check_docs() {
  (
    cd "$repository_root/apps/core"
    mise exec -- mix format --check-formatted ../../scripts/docs/*.exs
    mise exec -- mix run --no-start ../../scripts/docs/markdown_test.exs
  )
  mise exec -- node --test "$repository_root/scripts/docs/site.test.mjs" "$repository_root/scripts/docs/assembly.test.mjs"
  mise exec -- node --check "$repository_root/scripts/docs/build.mjs"
  mise exec -- node --check "$repository_root/scripts/docs/browser.mjs"
  mise exec -- node --check "$repository_root/scripts/docs/release-build.mjs"
  mise exec -- node --check "$repository_root/scripts/docs/assembly.mjs"
  mise exec -- node --check "$repository_root/scripts/docs/assemble.mjs"
  "$repository_root/scripts/build-site" --preview
  if [ "${1:-}" = '--browser' ]; then
    mise exec -- node "$repository_root/scripts/docs/release-build.mjs" --browser
  else
    mise exec -- node "$repository_root/scripts/docs/release-build.mjs"
  fi
}

check_docs_browser() {
  check_docs --browser
  mise exec -- node "$repository_root/scripts/docs/browser.mjs"
}

check_core() {
  check_kernel

  (
    cd "$repository_root/apps/core"
    mise exec -- mix check
  )

  "$repository_root/scripts/check-core-release"
}

check_mac_release() {
  (
    cd "$repository_root/release/macos"
    swift format lint --recursive --strict Sources Tests Package.swift
    swift test --parallel
    swift build --configuration release --product frameshift-mac-release
  )
}

check_release_portable() {
  (
    cd "$repository_root/release/portable/worker"
    mise exec -- zig fmt --check build.zig src
    mise exec -- zig build test
    mise exec -- zig build -Doptimize=ReleaseSafe
  )
  (
    cd "$repository_root/release/portable"
    mise exec -- mix format --check-formatted
    mise exec -- mix compile --warnings-as-errors
    mise exec -- mix test --warnings-as-errors
  )
}

check_macos() {
  mise exec -- node --test "$repository_root"/release/macos/*.test.mjs
  (
    cd "$repository_root/apps/macos"
    swift format lint --recursive --strict Sources Tests Package.swift

    swiftc_path=$(xcrun --find swiftc)
    swift_usr=$(CDPATH='' cd -- "$(dirname -- "$swiftc_path")/.." && pwd)
    testing_macros="$swift_usr/lib/swift/host/plugins/testing/libTestingMacros.dylib"

    if [ -f "$testing_macros" ]; then
      swift test --parallel \
        -Xswiftc -load-plugin-library \
        -Xswiftc "$testing_macros"
    else
      swift test --parallel
    fi

    swift run frameshift-shell-checks
  )

  "$repository_root/scripts/package-macos" >/dev/null
  mise exec -- node "$repository_root/release/macos/updater-bootstrap-fixture.mjs" \
    "$repository_root/apps/macos/.build/sparkle/Sparkle-for-Swift-Package-Manager.zip"
  mise exec -- node "$repository_root/release/macos/native-updater-fixture.mjs" \
    "$repository_root/apps/macos/.build/sparkle/Sparkle-for-Swift-Package-Manager.zip" \
    "$repository_root/apps/macos/.build/artifacts/macos/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/Sparkle.framework" \
    "$repository_root/apps/macos/.build/release/frameshift-updater-probe"

  app_bundle="$repository_root/apps/macos/.build/artifacts/Frameshift.app"
  test -x "$app_bundle/Contents/MacOS/Frameshift"
  test -x "$app_bundle/Contents/MacOS/frameshiftctl"
  test -x "$app_bundle/Contents/Resources/bin/frameshift-raster"
  test -x "$app_bundle/Contents/Resources/bin/frameshift-maintenance"
  test -x "$app_bundle/Contents/Resources/bin/launch-bundled-core"
  test -x "$app_bundle/Contents/Resources/core/bin/frameshift_core"
  test -s "$app_bundle/Contents/Resources/FrameshiftLight.icns"
  test -s "$app_bundle/Contents/Resources/FrameshiftDark.icns"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu.png"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu@2x.png"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu@3x.png"
  plutil -lint "$app_bundle/Contents/Info.plist" >/dev/null
  codesign --verify --deep --strict "$app_bundle"
  "$repository_root/scripts/check-macos-closure" "$app_bundle" "$(uname -m)" >/dev/null
  test "$(plutil -extract CFBundlePackageType raw "$app_bundle/Contents/Info.plist")" = "APPL"
  test "$(plutil -extract CFBundleIconFile raw "$app_bundle/Contents/Info.plist")" = "FrameshiftLight.icns"
  test "$(plutil -extract LSUIElement raw "$app_bundle/Contents/Info.plist")" = "true"
  test "$(plutil -extract CFBundleURLTypes.0.CFBundleURLSchemes.0 raw "$app_bundle/Contents/Info.plist")" = "frameshift"
  test "$(plutil -extract NSBonjourServices.0 raw "$app_bundle/Contents/Info.plist")" = "_frameshift._tcp"
  test "$(plutil -extract NSBonjourServices.1 raw "$app_bundle/Contents/Info.plist")" = "_frameshift-outbox._tcp"
  test -n "$(plutil -extract NSLocalNetworkUsageDescription raw "$app_bundle/Contents/Info.plist")"

  "$repository_root/scripts/check-packaged-app" "$app_bundle"
  swift build --package-path "$repository_root/apps/macos" --configuration release --product frameshift-shell-checks
  probe_directory=$(swift build --package-path "$repository_root/apps/macos" --configuration release --show-bin-path)
  mise exec -- node "$repository_root/release/macos/core-quit-fixture.mjs" \
    "$app_bundle" "$probe_directory/frameshift-shell-checks"
  mise exec -- node "$repository_root/release/macos/core-quit-fixture.mjs" \
    "$app_bundle" "$probe_directory/frameshift-shell-checks" --updater-quit
}

check_container() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker-compatible daemon required for the frame receiver lane" >&2
    return 1
  fi

  (
    cd "$repository_root/apps/core"
    mise exec -- env FRAMESHIFT_CONTAINER_TESTS=1 \
      mix test test/frameshift/container_receiver_test.exs
  )
}

check_linux_ipc() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker-compatible daemon required for Linux peer credential test" >&2
    return 1
  fi

  # Portable BEAM consumers are reused without starting a host-native SQLite
  # NIF. The Linux fixture owns a finite diagnostic store process instead.
  (
    cd "$repository_root/apps/core"
    mise exec -- env MIX_ENV=test mix compile --warnings-as-errors
  )

  docker run --rm --network none --read-only \
    --mount "type=bind,src=$repository_root/apps/core,dst=/src,readonly" \
    --tmpfs /tmp:mode=1777,size=16m,exec \
    elixir@sha256:3898ffe18d695e770239e4b342dc6b83136f52da0a37df2298083c03068cfd4e \
    elixir /src/test/frameshift/local_ipc/linux_peer_identity_contract.exs
}

check_linux_discovery() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker-compatible daemon required for Linux discovery test" >&2
    return 1
  fi

  (
    cd "$repository_root/apps/core"
    mise exec -- env MIX_ENV=test mix compile --warnings-as-errors
  )

  # The dated, signed Debian snapshot supplies only this isolated producer test.
  docker build --tag frameshift-linux-discovery:fixture - \
    < "$repository_root/apps/core/test/fixtures/linux-discovery.Dockerfile"
  docker run --rm --init --network bridge --read-only \
    --mount "type=bind,src=$repository_root/apps/core,dst=/src,readonly" \
    --tmpfs /tmp:mode=1777,size=32m --tmpfs /run:mode=0755,size=16m \
    frameshift-linux-discovery:fixture \
    elixir /src/test/frameshift/discovery/linux_avahi_join.exs
}

case "${1:-all}" in
  all)
    check_policy
    check_renderer
    check_codec
    "$repository_root/scripts/check-build-spec"
    check_core
    check_release
    check_release_portable
    check_guide
    check_docs
    check_mac_release
    check_macos
    ;;
  policy) check_policy ;;
  platform) check_platform ;;
  platform-browser) check_platform_browser ;;
  platform-observability) "$repository_root/scripts/check-platform-observability" ;;
  renderer) check_renderer ;;
  codec) check_codec ;;
  linux-codec) check_linux_codec ;;
  linux-release) check_linux_release ;;
  linux-deb) check_linux_deb ;;
  kernel) check_kernel ;;
  build-spec) "$repository_root/scripts/check-build-spec" ;;
  conjunct) mise exec -- node "$repository_root/scripts/conjunct/run.mjs" ;;
  guide) check_guide ;;
  guide-browser) check_guide_browser ;;
  docs) check_docs ;;
  docs-browser) check_docs_browser ;;
  core) check_core ;;
  release) check_release ;;
  macos) check_macos ;;
  mac-release) check_mac_release ;;
  release-portable) check_release_portable ;;
  container) check_container ;;
  linux-ipc) check_linux_ipc ;;
  linux-discovery) check_linux_discovery ;;
  keychain-pairing) "$repository_root/scripts/check-keychain-pairing" ;;
  *)
    echo "usage: scripts/check [all|policy|platform|platform-browser|platform-observability|renderer|codec|linux-codec|linux-release|linux-deb|kernel|build-spec|conjunct|guide|guide-browser|docs|docs-browser|core|release|macos|mac-release|release-portable|container|linux-ipc|linux-discovery|keychain-pairing]" >&2
    exit 64
    ;;
esac
