#!/bin/sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
app_bundle=${1:-"$repository_root/apps/macos/.build/artifacts/Frameshift.app"}
app="$app_bundle/Contents/MacOS/Frameshift"
core="$app_bundle/Contents/Resources/core/bin/frameshift_core"
renderer="$app_bundle/Contents/Resources/bin/frameshift-raster"
maintenance="$app_bundle/Contents/Resources/bin/frameshift-maintenance"
# The broker socket adds a nonce to this path; Darwin's sun_path is 104 bytes.
runtime_root=$(mktemp -d "/tmp/frameshift-pkg.XXXXXX")
app_pid=''
managed_core_pid=''
ipc_token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

cleanup() {
  if [ -n "$app_pid" ] && kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi

  if [ -n "$managed_core_pid" ] && kill -0 "$managed_core_pid" 2>/dev/null; then
    kill "$managed_core_pid" 2>/dev/null || true
  fi

  rm -rf "$runtime_root"
}

trap cleanup EXIT HUP INT TERM

test -x "$core"
test -x "$renderer"
test -x "$app_bundle/Contents/MacOS/frameshiftctl"
test -x "$maintenance"
test -f "$app_bundle/Contents/Resources/core/lib/frameshift_decisions-0.1.0/ebin/frameshift_decisions.beam"

kernel_result=$(
  FRAMESHIFT_RENDERER_PATH="$renderer" \
    "$core" eval 'IO.inspect(:frameshift_decisions.select_dwell(180000, 60000))'
)
test "$kernel_result" = '{:ok, 180000}'

profile_result=$(
  FRAMESHIFT_RENDERER_PATH="$renderer" \
    "$core" eval 'a={:raster_candidate,"z-photo",1600,1200,5760000,"rgb",8,"none",1,"not-applicable"}; b={:raster_candidate,"a-paper",800,600,1440000,"rgb",8,"none",1,"not-applicable"}; IO.inspect(:frameshift_decisions.select_rgb24_profile([a,b],"","continuous",["srgb"],"srgb"))'
)
test "$profile_result" = '{:ok, "a-paper"}'

FRAMESHIFT_DATA_DIR="$runtime_root/data" \
FRAMESHIFT_IPC_TOKEN="$ipc_token" \
FRAMESHIFT_SOCKET_PATH="$runtime_root/data/core.sock" \
ERL_CRASH_DUMP="$runtime_root/erl-crash.dump" \
ERL_CRASH_DUMP_SECONDS=0 \
  "$app" >"$runtime_root/app.log" 2>&1 &
app_pid=$!

attempt=0
while [ "$attempt" -lt 50 ]; do
  if ! kill -0 "$app_pid" 2>/dev/null; then
    cat "$runtime_root/app.log" >&2
    exit 1
  fi

  if [ -S "$runtime_root/data/core.sock" ]; then
    break
  fi

  attempt=$((attempt + 1))
  sleep 0.1
done

if [ ! -S "$runtime_root/data/core.sock" ] || [ ! -f "$runtime_root/data/core.pid" ]; then
  echo "packaged core did not create its local socket" >&2
  cat "$runtime_root/app.log" >&2
  exit 1
fi

if [ ! -S "$runtime_root/data/d.sock" ]; then
  echo "packaged core did not create its diagnostics socket" >&2
  exit 1
fi

managed_core_pid=$(cat "$runtime_root/data/core.pid")
case "$managed_core_pid" in
  '' | *[!0-9]*)
    echo "packaged core wrote an invalid pid file" >&2
    exit 1
    ;;
esac

FRAMESHIFT_SOCKET_PATH="$runtime_root/data/core.sock" \
FRAMESHIFT_IPC_TOKEN="$ipc_token" \
  swift run \
    --package-path "$repository_root/apps/macos" \
    frameshift-ipc-probe

FRAMESHIFT_DIAGNOSTICS_SOCKET_PATH="$runtime_root/data/d.sock" \
  "$app_bundle/Contents/MacOS/frameshiftctl" diagnostics health \
  >"$runtime_root/diagnostics.json"

if ! grep -Eq '"available"[[:space:]]*:[[:space:]]*true' "$runtime_root/diagnostics.json"; then
  echo "packaged diagnostics CLI did not report a running collector" >&2
  exit 1
fi

if ! grep -Eq '"metricPageBudgetBytes"[[:space:]]*:[[:space:]]*33554432' "$runtime_root/diagnostics.json" || \
   ! grep -Eq '"metricAllocatedBytes"[[:space:]]*:[[:space:]]*[0-9]+' "$runtime_root/diagnostics.json"; then
  echo "packaged diagnostics CLI did not report the metric page budget" >&2
  exit 1
fi

FRAMESHIFT_DIAGNOSTICS_SOCKET_PATH="$runtime_root/data/d.sock" \
  "$app_bundle/Contents/MacOS/frameshiftctl" diagnostics metrics --limit 2 \
  >"$runtime_root/metrics.json"

if ! grep -Eq '"catalog"' "$runtime_root/metrics.json" || \
   ! grep -Eq '"entries"' "$runtime_root/metrics.json"; then
  echo "packaged diagnostics CLI did not return a metric page and catalog" >&2
  exit 1
fi

FRAMESHIFT_DIAGNOSTICS_SOCKET_PATH="$runtime_root/data/d.sock" \
  "$app_bundle/Contents/MacOS/frameshiftctl" diagnostics audit --limit 2 \
  >"$runtime_root/audit.json"

if ! grep -Eq '"entries"' "$runtime_root/audit.json"; then
  echo "packaged diagnostics CLI did not return an audit page" >&2
  exit 1
fi

if FRAMESHIFT_DATA_DIR="$runtime_root/data" \
  "$maintenance" backup "$runtime_root/backup" >"$runtime_root/active-backup.log" 2>&1; then
  echo "maintenance command accepted a running core" >&2
  exit 1
fi

kill "$app_pid"
wait "$app_pid" 2>/dev/null || true
app_pid=''

attempt=0
while [ "$attempt" -lt 40 ] && kill -0 "$managed_core_pid" 2>/dev/null; do
  attempt=$((attempt + 1))
  sleep 0.05
done

if kill -0 "$managed_core_pid" 2>/dev/null; then
  echo "packaged app did not stop its managed core" >&2
  exit 1
fi

managed_core_pid=''

FRAMESHIFT_DATA_DIR="$runtime_root/data" \
  "$maintenance" backup "$runtime_root/backup" >"$runtime_root/backup.log"

"$maintenance" verify "$runtime_root/backup" >"$runtime_root/verify.log"
"$maintenance" restore "$runtime_root/backup" "$runtime_root/restored" \
  >"$runtime_root/restore.log"

test -f "$runtime_root/restored/metadata.sqlite"
if "$maintenance" restore "$runtime_root/backup" "$runtime_root/restored" \
  >"$runtime_root/duplicate-restore.log" 2>&1; then
  echo "maintenance command replaced an existing destination" >&2
  exit 1
fi

printf 'damage' >>"$runtime_root/backup/metadata.sqlite"
if "$maintenance" verify "$runtime_root/backup" >"$runtime_root/corrupt-verify.log" 2>&1; then
  echo "maintenance command accepted a corrupted backup" >&2
  exit 1
fi
