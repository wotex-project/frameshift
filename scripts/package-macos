#!/bin/sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
package_root="$repository_root/apps/macos"
core_root="$repository_root/apps/core"
renderer_root="$repository_root/renderer"
artifact_root="$package_root/.build/artifacts"
app_bundle="$artifact_root/Frameshift.app"
release_root="$core_root/_build/prod/rel/frameshift_core"
renderer_path="$renderer_root/zig-out/bin/frameshift-raster"
architecture=$(uname -m)
case "$architecture" in
  arm64) renderer_target=aarch64-macos.14.0 ;;
  x86_64) renderer_target=x86_64-macos.14.0 ;;
  *) echo 'unsupported development Mac architecture' >&2; exit 1 ;;
esac

(
  cd "$renderer_root"
  mise exec -- zig build -Doptimize=ReleaseSafe "-Dtarget=$renderer_target"
)

(
  cd "$core_root"
  # A clean checkout needs the native compiler/runtime dependencies before the
  # forced native build starts. Use a separate Mix VM so dependency statuses
  # observed before helper compilation cannot remain cached as outdated.
  mise exec -- env MIX_ENV=prod mix deps.compile elixir_make cc_precompiler telemetry db_connection
  mise exec -- env MIX_ENV=prod mix deps.clean exqlite --build
  mise exec -- env -u EXQLITE_USE_SYSTEM MIX_ENV=prod MACOSX_DEPLOYMENT_TARGET=14.0 \
    "FRAMESHIFT_RENDERER_PATH=$renderer_path" \
    mix run --no-start --no-compile --no-deps-check -e \
    'Application.put_env(:elixir_make, :force_build, exqlite: true); Mix.Task.run("deps.compile", ["exile", "exqlite", "--force"])'
  mise exec -- env MIX_ENV=prod MACOSX_DEPLOYMENT_TARGET=14.0 mix release --overwrite
)

swift build \
  --package-path "$package_root" \
  --configuration release \
  --product frameshift-menu

swift build \
  --package-path "$package_root" \
  --configuration release \
  --product frameshiftctl

binary_directory=$(
  swift build \
    --package-path "$package_root" \
    --configuration release \
    --show-bin-path
)

mkdir -p "$artifact_root"
staging_root=$(mktemp -d "$artifact_root/.package.XXXXXX")
stage="$staging_root/Frameshift.app"

cleanup() {
  if [ -n "${staging_root:-}" ] && [ -d "$staging_root" ]; then
    rm -rf "$staging_root"
  fi
}

trap cleanup EXIT HUP INT TERM

mkdir -p "$stage/Contents/MacOS" "$stage/Contents/Resources"
install -m 755 "$binary_directory/frameshift-menu" "$stage/Contents/MacOS/Frameshift"
install -m 755 "$binary_directory/frameshiftctl" "$stage/Contents/MacOS/frameshiftctl"
install -m 644 "$package_root/App/Info.plist" "$stage/Contents/Info.plist"

"$repository_root/scripts/build-macos-icons" "$stage/Contents/Resources"

mkdir -p "$stage/Contents/Resources/bin"
install -m 755 \
  "$repository_root/scripts/frameshift-maintenance" \
  "$stage/Contents/Resources/bin/frameshift-maintenance"
install -m 755 "$renderer_path" "$stage/Contents/Resources/bin/frameshift-raster"
install -m 755 \
  "$repository_root/scripts/launch-bundled-core" \
  "$stage/Contents/Resources/bin/launch-bundled-core"
ditto "$release_root" "$stage/Contents/Resources/core"

# Some upstream data files arrive group-writable. Normalize only this private
# stage; never edit the dependency cache or a previously accepted bundle.
find "$stage" -type f -exec chmod go-w,u-s,g-s {} +
find "$stage" -type d -exec chmod go-w,u-s,g-s,-t {} +

plutil -lint "$stage/Contents/Info.plist" >/dev/null
mise exec -- node "$repository_root/release/macos/prepare.mjs" "$stage" "$architecture" >&2
"$repository_root/scripts/check-macos-closure" "$stage" "$architecture" >/dev/null

if [ -e "$app_bundle" ]; then
  rm -rf "$app_bundle"
fi

mv "$stage" "$app_bundle"
rm -rf "$staging_root"
staging_root=''

printf '%s\n' "$app_bundle"
