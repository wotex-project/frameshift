#!/bin/sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
core_root="$repository_root/apps/core"
renderer_path="$repository_root/renderer/zig-out/bin/frameshift-raster"
release_root="$core_root/_build/prod/rel/frameshift_core"
runtime_root=$(mktemp -d "${TMPDIR:-/tmp}/frameshift-release-check.XXXXXX")
release_pid=''
ipc_token=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ipc_token_file="$runtime_root/ipc-token"

cleanup() {
  if [ -n "$release_pid" ] && kill -0 "$release_pid" 2>/dev/null; then
    kill "$release_pid" 2>/dev/null || true
    wait "$release_pid" 2>/dev/null || true
  fi

  rm -rf "$runtime_root"
}

trap cleanup EXIT HUP INT TERM

(
  cd "$core_root"
  mise exec -- env MIX_ENV=prod mix release --overwrite
)

# The CLI clean boot neither reads service runtime config nor requires the
# customer's development tools or service release cookie. Never boot the service
# for these read-only launcher checks.
cli_version=$(
  env -u FRAMESHIFT_RENDERER_PATH -u FRAMESHIFT_IPC_TOKEN_FILE \
    FRAMESHIFT_DATA_DIR="$runtime_root/cli-data" \
    PATH=/usr/bin:/bin "$release_root/bin/frameshiftctl" --version
)
test "$cli_version" = 'frameshiftctl 0.1.0-dev'
env -u FRAMESHIFT_RENDERER_PATH -u FRAMESHIFT_IPC_TOKEN_FILE \
  FRAMESHIFT_DATA_DIR="$runtime_root/cli-data" \
  PATH=/usr/bin:/bin "$release_root/bin/frameshiftctl" --help >"$runtime_root/cli-help"
test ! -e "$runtime_root/cli-data"

physical_result=$(
  FRAMESHIFT_RENDERER_PATH="$renderer_path" \
    "$release_root/bin/frameshift_core" eval \
    'IO.inspect(:frameshift_physical.millimetres("596.736"))'
)
test "$physical_result" = '{:ok, 596736}'
test ! -f "$release_root/lib/frameshift_decisions-0.1.0/ebin/frameshift_physical_test.beam"

set +e
missing_path_output=$(
  env -u FRAMESHIFT_RENDERER_PATH \
    ERL_CRASH_DUMP="$runtime_root/missing-path.dump" \
    ERL_CRASH_DUMP_SECONDS=0 \
    "$release_root/bin/frameshift_core" eval ':ok' 2>&1
)
missing_path_status=$?
set -e

if [ "$missing_path_status" -eq 0 ]; then
  echo "production release started without FRAMESHIFT_RENDERER_PATH" >&2
  exit 1
fi

case "$missing_path_output" in
  *"FRAMESHIFT_RENDERER_PATH is required in production"*) ;;
  *)
    printf '%s\n' "$missing_path_output" >&2
    exit 1
    ;;
esac

umask 077
printf '%s' "$ipc_token" >"$ipc_token_file"
chmod 600 "$ipc_token_file"

# An unavailable diagnostic sink must not prevent authoritative host startup.
# These paths are isolated fixture data, never an existing user library.
mkdir -p "$runtime_root/data" "$runtime_root/unrelated-log-directory"
chmod 755 "$runtime_root/unrelated-log-directory"
printf 'preserve unrelated bytes' >"$runtime_root/unrelated-log-directory/sentinel"
ln -s "$runtime_root/unrelated-log-directory" "$runtime_root/data/diagnostics"

FRAMESHIFT_DATA_DIR="$runtime_root/data" \
FRAMESHIFT_IPC_TOKEN_FILE="$ipc_token_file" \
FRAMESHIFT_RENDERER_PATH="$renderer_path" \
RELEASE_DISTRIBUTION=none \
  "$release_root/bin/frameshift_core" start >"$runtime_root/release.log" 2>&1 &
release_pid=$!

attempt=0
while [ "$attempt" -lt 50 ]; do
  if ! kill -0 "$release_pid" 2>/dev/null; then
    cat "$runtime_root/release.log" >&2
    exit 1
  fi

  if [ -f "$runtime_root/data/metadata.sqlite" ] && [ -S "$runtime_root/data/core.sock" ]; then
    break
  fi

  attempt=$((attempt + 1))
  sleep 0.1
done

if [ ! -f "$runtime_root/data/metadata.sqlite" ] || [ ! -S "$runtime_root/data/core.sock" ]; then
  echo "production release did not initialize its metadata store and local socket" >&2
  cat "$runtime_root/release.log" >&2
  exit 1
fi

sleep 1

if ! kill -0 "$release_pid" 2>/dev/null; then
  echo "production release exited after initialization" >&2
  cat "$runtime_root/release.log" >&2
  exit 1
fi

if [ "$(uname -s)" = Darwin ]; then
  FRAMESHIFT_SOCKET_PATH="$runtime_root/data/core.sock" \
  FRAMESHIFT_IPC_TOKEN="$ipc_token" \
    swift run \
      --package-path "$repository_root/apps/macos" \
      frameshift-ipc-probe

  FRAMESHIFT_DIAGNOSTICS_SOCKET_PATH="$runtime_root/data/d.sock" \
    swift run \
      --package-path "$repository_root/apps/macos" \
      frameshiftctl diagnostics health >"$runtime_root/fallback-health.json"

  if ! grep -Eq '"scope"[[:space:]]*:[[:space:]]*"handler_configuration"' "$runtime_root/fallback-health.json" || \
     ! grep -Eq '"state"[[:space:]]*:[[:space:]]*"unavailable"' "$runtime_root/fallback-health.json"; then
    echo "diagnostic health did not report the unavailable fallback sink" >&2
    exit 1
  fi
fi

test "$(cat "$runtime_root/unrelated-log-directory/sentinel")" = 'preserve unrelated bytes'
test ! -e "$runtime_root/unrelated-log-directory/core-fallback.log"
test "$(find "$runtime_root/unrelated-log-directory" -type f | wc -l | tr -d ' ')" = 1

kill "$release_pid"
wait "$release_pid"
release_pid=''
