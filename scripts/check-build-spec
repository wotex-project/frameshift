#!/bin/sh
set -eu
repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
parity_directory=$(mktemp -d)
trap 'rm -rf "$parity_directory"' 0 HUP INT TERM
cd "$repository_root/packages/build-spec"

mise exec -- gleam deps download
cmp build/packages/gleam_json/LICENCE priv/licenses/gleam_json.txt
cmp build/packages/gleam_stdlib/LICENCE ../decision-kernel/priv/licenses/gleam_stdlib.txt

mise exec -- mix deps.get --check-locked
mise exec -- gleam format --check src test
mise exec -- gleam build --target erlang --warnings-as-errors
mise exec -- gleam build --target javascript --warnings-as-errors
mise exec -- gleam test --target erlang
mise exec -- gleam test --target javascript
mise exec -- mix format --check-formatted
mise exec -- mix compile --warnings-as-errors
mise exec -- mix test
mise exec -- mix credo --strict
mise exec -- node --check js/profile.mjs
mise exec -- node --check js/build.mjs
mise exec -- node --check js/mapping.mjs
mise exec -- node --check js/context.mjs
mise exec -- node --check js/layout.mjs
mise exec -- node --check js/preview.mjs
mise exec -- node --check js/identity.mjs
mise exec -- node --check test/identity_parity.mjs
mise exec -- node --check checks/catalog.mjs
mise exec -- node checks/catalog.mjs
mise exec -- node --test test/profile.test.mjs test/catalog.test.mjs test/build.test.mjs test/resolution.test.mjs test/facts.test.mjs test/mapping.test.mjs test/context.test.mjs test/layout.test.mjs test/preview.test.mjs

mise exec -- gleam run --target erlang --module profile_parity --no-print-progress > "$parity_directory/erlang.jsonl"
mise exec -- gleam run --target javascript --module profile_parity --no-print-progress > "$parity_directory/javascript.jsonl"
cmp "$parity_directory/erlang.jsonl" "$parity_directory/javascript.jsonl"
test "$(wc -l < "$parity_directory/erlang.jsonl" | tr -d ' ')" = 256
mise exec -- mix run --no-start --no-compile \
  checks/identity_parity.exs "$parity_directory/erlang.jsonl" > "$parity_directory/erlang.hashes"
mise exec -- node test/identity_parity.mjs "$parity_directory/javascript.jsonl" > "$parity_directory/javascript.hashes"
cmp "$parity_directory/erlang.hashes" "$parity_directory/javascript.hashes"
echo "256 canonical profiles and SHA-256 identities match on BEAM and JavaScript"

mise exec -- gleam run --target erlang --module assembly_parity --no-print-progress > "$parity_directory/assembly.erlang.jsonl"
mise exec -- gleam run --target javascript --module assembly_parity --no-print-progress > "$parity_directory/assembly.javascript.jsonl"
cmp "$parity_directory/assembly.erlang.jsonl" "$parity_directory/assembly.javascript.jsonl"
test "$(wc -l < "$parity_directory/assembly.erlang.jsonl" | tr -d ' ')" = 256
mise exec -- mix run --no-start --no-compile \
  checks/identity_parity.exs "$parity_directory/assembly.erlang.jsonl" assembly > "$parity_directory/assembly.erlang.hashes"
mise exec -- node test/identity_parity.mjs "$parity_directory/assembly.javascript.jsonl" assembly > "$parity_directory/assembly.javascript.hashes"
cmp "$parity_directory/assembly.erlang.hashes" "$parity_directory/assembly.javascript.hashes"
echo "256 canonical assemblies and SHA-256 identities match on BEAM and JavaScript"

mise exec -- gleam run --target erlang --module mapping_parity --no-print-progress > "$parity_directory/mapping.erlang.jsonl"
mise exec -- gleam run --target javascript --module mapping_parity --no-print-progress > "$parity_directory/mapping.javascript.jsonl"
cmp "$parity_directory/mapping.erlang.jsonl" "$parity_directory/mapping.javascript.jsonl"
test "$(wc -l < "$parity_directory/mapping.erlang.jsonl" | tr -d ' ')" = 256
mise exec -- mix run --no-start --no-compile \
  checks/identity_parity.exs "$parity_directory/mapping.erlang.jsonl" mapping > "$parity_directory/mapping.erlang.hashes"
mise exec -- node test/identity_parity.mjs "$parity_directory/mapping.javascript.jsonl" mapping > "$parity_directory/mapping.javascript.hashes"
cmp "$parity_directory/mapping.erlang.hashes" "$parity_directory/mapping.javascript.hashes"
echo "256 canonical signal mappings and SHA-256 identities match on BEAM and JavaScript"

mise exec -- gleam run --target erlang --module layout_parity --no-print-progress > "$parity_directory/layout.erlang.jsonl"
mise exec -- gleam run --target javascript --module layout_parity --no-print-progress > "$parity_directory/layout.javascript.jsonl"
cmp "$parity_directory/layout.erlang.jsonl" "$parity_directory/layout.javascript.jsonl"
test "$(wc -l < "$parity_directory/layout.erlang.jsonl" | tr -d ' ')" = 256
mise exec -- mix run --no-start --no-compile \
  checks/identity_parity.exs "$parity_directory/layout.erlang.jsonl" layout > "$parity_directory/layout.erlang.hashes"
mise exec -- node test/identity_parity.mjs "$parity_directory/layout.javascript.jsonl" layout > "$parity_directory/layout.javascript.hashes"
cmp "$parity_directory/layout.erlang.hashes" "$parity_directory/layout.javascript.hashes"
echo "256 canonical artifact layouts and SHA-256 identities match on BEAM and JavaScript"

mise exec -- gleam run --target erlang --module context_fixture --no-print-progress > "$parity_directory/context.erlang.jsonl"
mise exec -- gleam run --target javascript --module context_fixture --no-print-progress > "$parity_directory/context.javascript.jsonl"
cmp "$parity_directory/context.erlang.jsonl" "$parity_directory/context.javascript.jsonl"
mise exec -- node --check checks/context-fixture.mjs
mise exec -- node checks/context-fixture.mjs "$parity_directory/context.erlang.jsonl"

mise exec -- gleam run --target erlang --module preview_parity --no-print-progress > "$parity_directory/preview.erlang.jsonl"
mise exec -- gleam run --target javascript --module preview_parity --no-print-progress > "$parity_directory/preview.javascript.jsonl"
cmp "$parity_directory/preview.erlang.jsonl" "$parity_directory/preview.javascript.jsonl"
test "$(wc -l < "$parity_directory/preview.erlang.jsonl" | tr -d ' ')" = 3
echo "Three complete stage/check/reference previews match on BEAM and JavaScript"

mise exec -- gleam run --target erlang --module graph_parity --no-print-progress > "$parity_directory/graph.erlang.jsonl"
mise exec -- gleam run --target javascript --module graph_parity --no-print-progress > "$parity_directory/graph.javascript.jsonl"
cmp "$parity_directory/graph.erlang.jsonl" "$parity_directory/graph.javascript.jsonl"
mise exec -- node --check checks/graph-oracle.mjs
mise exec -- node checks/graph-oracle.mjs "$parity_directory/graph.erlang.jsonl"

mise exec -- gleam run --target erlang --module geometry_parity --no-print-progress > "$parity_directory/geometry.erlang.jsonl"
mise exec -- gleam run --target javascript --module geometry_parity --no-print-progress > "$parity_directory/geometry.javascript.jsonl"
cmp "$parity_directory/geometry.erlang.jsonl" "$parity_directory/geometry.javascript.jsonl"
mise exec -- node --check checks/geometry-oracle.mjs
mise exec -- node checks/geometry-oracle.mjs "$parity_directory/geometry.erlang.jsonl"

mise exec -- gleam run --target erlang --module rectangles_parity --no-print-progress > "$parity_directory/rectangles.erlang.jsonl"
mise exec -- gleam run --target javascript --module rectangles_parity --no-print-progress > "$parity_directory/rectangles.javascript.jsonl"
cmp "$parity_directory/rectangles.erlang.jsonl" "$parity_directory/rectangles.javascript.jsonl"
mise exec -- node --check checks/rectangles-oracle.mjs
mise exec -- node checks/rectangles-oracle.mjs "$parity_directory/rectangles.erlang.jsonl"

mise exec -- gleam run --target erlang --module projection_parity --no-print-progress > "$parity_directory/projection.erlang.jsonl"
mise exec -- gleam run --target javascript --module projection_parity --no-print-progress > "$parity_directory/projection.javascript.jsonl"
cmp "$parity_directory/projection.erlang.jsonl" "$parity_directory/projection.javascript.jsonl"
mise exec -- node --check checks/projection-oracle.mjs
mise exec -- node checks/projection-oracle.mjs "$parity_directory/projection.erlang.jsonl"

mise exec -- gleam run --target erlang --module power_parity --no-print-progress > "$parity_directory/power.erlang.jsonl"
mise exec -- gleam run --target javascript --module power_parity --no-print-progress > "$parity_directory/power.javascript.jsonl"
cmp "$parity_directory/power.erlang.jsonl" "$parity_directory/power.javascript.jsonl"
mise exec -- node --check checks/power-oracle.mjs
mise exec -- node checks/power-oracle.mjs "$parity_directory/power.erlang.jsonl"

mise exec -- gleam run --target erlang --module port_graph_parity --no-print-progress > "$parity_directory/port-graph.erlang.jsonl"
mise exec -- gleam run --target javascript --module port_graph_parity --no-print-progress > "$parity_directory/port-graph.javascript.jsonl"
cmp "$parity_directory/port-graph.erlang.jsonl" "$parity_directory/port-graph.javascript.jsonl"
mise exec -- node --check checks/port-graph-oracle.mjs
mise exec -- node checks/port-graph-oracle.mjs "$parity_directory/port-graph.erlang.jsonl"

mise exec -- gleam run --target erlang --module flow_parity --no-print-progress > "$parity_directory/flow.erlang.jsonl"
mise exec -- gleam run --target javascript --module flow_parity --no-print-progress > "$parity_directory/flow.javascript.jsonl"
cmp "$parity_directory/flow.erlang.jsonl" "$parity_directory/flow.javascript.jsonl"
mise exec -- node --check checks/flow-oracle.mjs
mise exec -- node checks/flow-oracle.mjs "$parity_directory/flow.erlang.jsonl"

mise exec -- gleam run --target erlang --module thermal_parity --no-print-progress > "$parity_directory/thermal.erlang.jsonl"
mise exec -- gleam run --target javascript --module thermal_parity --no-print-progress > "$parity_directory/thermal.javascript.jsonl"
cmp "$parity_directory/thermal.erlang.jsonl" "$parity_directory/thermal.javascript.jsonl"
mise exec -- node --check checks/thermal-oracle.mjs
mise exec -- node checks/thermal-oracle.mjs "$parity_directory/thermal.erlang.jsonl"

mise exec -- gleam run --target erlang --module mount_parity --no-print-progress > "$parity_directory/mount.erlang.jsonl"
mise exec -- gleam run --target javascript --module mount_parity --no-print-progress > "$parity_directory/mount.javascript.jsonl"
cmp "$parity_directory/mount.erlang.jsonl" "$parity_directory/mount.javascript.jsonl"
mise exec -- node --check checks/mount-oracle.mjs
mise exec -- node checks/mount-oracle.mjs "$parity_directory/mount.erlang.jsonl"

mise exec -- gleam run --target erlang --module route_parity --no-print-progress > "$parity_directory/route.erlang.jsonl"
mise exec -- gleam run --target javascript --module route_parity --no-print-progress > "$parity_directory/route.javascript.jsonl"
cmp "$parity_directory/route.erlang.jsonl" "$parity_directory/route.javascript.jsonl"
mise exec -- node --check checks/route-oracle.mjs
mise exec -- node checks/route-oracle.mjs "$parity_directory/route.erlang.jsonl"

mise exec -- gleam run --target erlang --module artifact_parity --no-print-progress > "$parity_directory/artifact.erlang.jsonl"
mise exec -- gleam run --target javascript --module artifact_parity --no-print-progress > "$parity_directory/artifact.javascript.jsonl"
cmp "$parity_directory/artifact.erlang.jsonl" "$parity_directory/artifact.javascript.jsonl"
mise exec -- node --check checks/artifact-oracle.mjs
mise exec -- node checks/artifact-oracle.mjs "$parity_directory/artifact.erlang.jsonl"

cat "$repository_root"/data/physical/profiles/*.json > "$parity_directory/catalog.jsonl"
mise exec -- mix run --no-start --no-compile \
  checks/identity_parity.exs "$parity_directory/catalog.jsonl" > "$parity_directory/catalog.erlang.hashes"
mise exec -- node test/identity_parity.mjs "$parity_directory/catalog.jsonl" > "$parity_directory/catalog.javascript.hashes"
cmp "$parity_directory/catalog.erlang.hashes" "$parity_directory/catalog.javascript.hashes"
echo "Sourced candidate profiles and hashes match on BEAM and JavaScript"

mise exec -- env MIX_ENV=prod mix release --overwrite --path "$parity_directory/release" >/dev/null
"$parity_directory/release/bin/frameshift_build" eval '
{:ok, _} = FrameshiftBuild.profile_identity(File.read!("test/fixtures/profile-v1.json"))
{:ok, _} = FrameshiftBuild.build_identity(File.read!("test/fixtures/assembly-v1.json"))
{:ok, _} = FrameshiftBuild.mapping_identity(File.read!("test/fixtures/mapping-v1.json"))
{:ok, _} = FrameshiftBuild.layout_identity(File.read!("test/fixtures/layout-v1.json"))
{:ok, %{context: {:context, {:resolution, _, [], [_, _]}, [], []}}} = FrameshiftBuild.resolve_context(File.read!("test/fixtures/assembly-v1.json"), [], [])
{:ok, %{status: preview_status, stages: preview_stages}} = FrameshiftBuild.planning_preview(File.read!("test/fixtures/assembly-v1.json"), [], [])
true = preview_status in ["unknown", "incompatible"]
13 = length(preview_stages)
{:ok, [_, _]} = FrameshiftBuild.profile_pins(File.read!("test/fixtures/assembly-v1.json"))
{:ok, %{resolution: {:resolution, _, [], [_, _]}}} = FrameshiftBuild.resolve_build(File.read!("test/fixtures/assembly-v1.json"), [])
true = File.regular?(Application.app_dir(:frameshift_build, "priv/licenses/gleam_json.txt"))
true = File.regular?(Application.app_dir(:frameshift_decisions, "priv/licenses/gleam_stdlib.txt"))
:non_existing = :code.which(:profile_fixture)
:non_existing = :code.which(:frameshift_build_test)
:non_existing = :code.which(:assembly_fixture)
:non_existing = :code.which(:assembly_test)
:non_existing = :code.which(:resolution_test)
:non_existing = :code.which(:graph_fixture)
:non_existing = :code.which(:graph_checks_test)
:non_existing = :code.which(:facts_test)
:non_existing = :code.which(:geometry_test)
:non_existing = :code.which(:geometry_fixture)
:non_existing = :code.which(:geometry_parity)
:non_existing = :code.which(:rectangles_test)
:non_existing = :code.which(:rectangles_parity)
:non_existing = :code.which(:viewing_fixture)
:non_existing = :code.which(:viewing_test)
:non_existing = :code.which(:projection_test)
:non_existing = :code.which(:projection_parity)
:non_existing = :code.which(:power_fixture)
:non_existing = :code.which(:power_interfaces_test)
:non_existing = :code.which(:power_parity)
:non_existing = :code.which(:load_fixture)
:non_existing = :code.which(:power_loads_test)
:non_existing = :code.which(:port_graph_test)
:non_existing = :code.which(:port_graph_parity)
:non_existing = :code.which(:contract_fixture)
:non_existing = :code.which(:power_contracts_test)
:non_existing = :code.which(:flow_fixture)
:non_existing = :code.which(:power_flow_test)
:non_existing = :code.which(:flow_parity)
:non_existing = :code.which(:evidence_test)
:non_existing = :code.which(:thermal_fixture)
:non_existing = :code.which(:thermal_test)
:non_existing = :code.which(:thermal_parity)
:non_existing = :code.which(:mount_fixture)
:non_existing = :code.which(:mounting_test)
:non_existing = :code.which(:mount_parity)
:non_existing = :code.which(:signal_fixture)
:non_existing = :code.which(:signals_test)
:non_existing = :code.which(:operation_fixture)
:non_existing = :code.which(:operation_test)
:non_existing = :code.which(:completeness_fixture)
:non_existing = :code.which(:completeness_test)
:non_existing = :code.which(:route_fixture)
:non_existing = :code.which(:route_parity)
:non_existing = :code.which(:signal_routes_test)
:non_existing = :code.which(:mapping_fixture)
:non_existing = :code.which(:mapping_parity)
:non_existing = :code.which(:mapping_test)
:non_existing = :code.which(:context_fixture)
:non_existing = :code.which(:context_test)
:non_existing = :code.which(:preview_test)
:non_existing = :code.which(:preview_parity)
:non_existing = :code.which(:artifact_fixture)
:non_existing = :code.which(:artifact_parity)
:non_existing = :code.which(:artifacts_test)
:non_existing = :code.which(:layout_fixture)
:non_existing = :code.which(:layout_parity)
:non_existing = :code.which(:layout_test)
{:ok, []} = :frameshift_build@graph.cyclic_nodes(["a", "b"], [{"a", "b"}])
IO.puts("Packaged BuildSpec codec and planning preview pass; test modules excluded")
'
